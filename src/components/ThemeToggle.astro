---
// Bascule clair/sombre : bouton fixe au centre-droit de l'écran, dessiné
// comme le disque du fond — cercle de construction tireté, repères en croix,
// lune (thème clair) ou soleil (thème sombre) en filaire. L'icône annonce
// l'action : la lune quand cliquer passe en sombre, le soleil pour le clair.
---

<button class="theme-toggle" id="theme-toggle" type="button" aria-pressed="true" aria-label="passer en mode clair">
  <svg viewBox="0 0 64 64" aria-hidden="true">
    <!-- Cercle de construction + repères, comme les guides du disque. -->
    <g class="guides">
      <circle class="ring" cx="32" cy="32" r="24" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="3 4.5"></circle>
      <g stroke="currentColor" stroke-width="1">
        <line x1="32" y1="4" x2="32" y2="11"></line>
        <line x1="32" y1="53" x2="32" y2="60"></line>
        <line x1="4" y1="32" x2="11" y2="32"></line>
        <line x1="53" y1="32" x2="60" y2="32"></line>
      </g>
    </g>

    <!-- Lune : visible en thème clair (cliquer → sombre). -->
    <g class="icon moon" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
      <circle cx="32" cy="32" r="9.5" stroke-width="1" stroke-dasharray="2 3" opacity="0.45"></circle>
      <path d="M 33.5 22.8 A 9.4 9.4 0 1 0 33.5 41.2 A 11.8 11.8 0 0 1 33.5 22.8 Z"></path>
    </g>

    <!-- Soleil : visible en thème sombre (cliquer → clair). -->
    <g class="icon sun" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
      <circle cx="32" cy="32" r="7"></circle>
      <g stroke-width="1.25">
        <line x1="32" y1="20.5" x2="32" y2="16.5"></line>
        <line x1="32" y1="47.5" x2="32" y2="43.5"></line>
        <line x1="20.5" y1="32" x2="16.5" y2="32"></line>
        <line x1="47.5" y1="32" x2="43.5" y2="32"></line>
        <line x1="23.9" y1="23.9" x2="21" y2="21"></line>
        <line x1="43" y1="43" x2="40.1" y2="40.1"></line>
        <line x1="40.1" y1="23.9" x2="43" y2="21"></line>
        <line x1="21" y1="43" x2="23.9" y2="40.1"></line>
      </g>
    </g>
  </svg>
</button>

<style>
  .theme-toggle {
    position: fixed;
    top: 50%;
    right: 22px;
    transform: translateY(-50%);
    z-index: 20;
    width: 56px;
    height: 56px;
    padding: 0;
    background: none;
    border: 0;
    color: var(--text-dim);
    cursor: pointer;
    transition: color 0.3s ease;
  }

  .theme-toggle:hover {
    color: var(--signal);
  }

  .theme-toggle svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Le cercle de construction tourne lentement, comme le disque au repos. */
  .ring {
    transform-origin: 32px 32px;
    animation: turn 48s linear infinite;
  }

  .theme-toggle:hover .ring {
    animation-duration: 14s;
  }

  @keyframes turn {
    to {
      transform: rotate(360deg);
    }
  }

  /* Bascule lune/soleil : fondu + légère rotation, pilotée par le thème. */
  .icon {
    transform-origin: 32px 32px;
    transition:
      opacity 0.35s ease,
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .moon {
    opacity: 0;
    transform: rotate(60deg) scale(0.7);
  }

  :global(html[data-theme='light']) .sun {
    opacity: 0;
    transform: rotate(-60deg) scale(0.7);
  }

  :global(html[data-theme='light']) .moon {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 720px) {
    .theme-toggle {
      right: 10px;
      width: 46px;
      height: 46px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ring {
      animation: none;
    }
  }
</style>

<script>
  import { initThemeToggle } from '../scripts/theme';

  initThemeToggle();
</script>
