---
// Fond de l'accueil : canvas 3D (disque filaire), calque « feuille de plan »
// (cadre coté, cercles de construction, croix de repère), halo signal, grain
// fin. Tout reste en z-index 0-1, sous le contenu (z-index 5+).

/** Positions des graduations le long du cadre (viewBox 1440×900). */
const ticksX = Array.from({ length: 11 }, (_, i) => 160 + i * 112);
const ticksY = Array.from({ length: 6 }, (_, i) => 160 + i * 112);
---

<div class="stage"><canvas id="gl"></canvas></div>

<!-- Feuille de plan : lignes de construction fixes, sous le halo et le grain. -->
<svg class="blueprint" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <!-- Cadre de la feuille + graduations. -->
  <g class="frame">
    <rect x="48" y="48" width="1344" height="804" fill="none" stroke="currentColor"></rect>
    <g class="ticks">
      {ticksX.map((x) => <line x1={x} y1="48" x2={x} y2="56" stroke="currentColor" />)}
      {ticksX.map((x) => <line x1={x} y1="844" x2={x} y2="852" stroke="currentColor" />)}
      {ticksY.map((y) => <line x1="48" y1={y} x2="56" y2={y} stroke="currentColor" />)}
      {ticksY.map((y) => <line x1="1384" y1={y} x2="1392" y2={y} stroke="currentColor" />)}
    </g>
  </g>

  <!-- Croix de repère aux coins du cadre. -->
  <g class="corners" stroke="currentColor">
    {
      [
        [48, 48],
        [1392, 48],
        [48, 852],
        [1392, 852],
      ].map(([x, y]) => (
        <g>
          <line x1={x - 14} y1={y} x2={x + 14} y2={y} />
          <line x1={x} y1={y - 14} x2={x} y2={y + 14} />
        </g>
      ))
    }
  </g>

  <!-- Cercles de construction : échos du disque, en rotation très lente. -->
  <g class="circles">
    <circle class="c-slow" cx="1150" cy="430" r="330" fill="none" stroke="currentColor" stroke-dasharray="5 9"></circle>
    <circle cx="1150" cy="430" r="252" fill="none" stroke="currentColor" opacity="0.5"></circle>
    <circle class="c-rev" cx="170" cy="770" r="216" fill="none" stroke="currentColor" stroke-dasharray="4 8"></circle>
    <line x1="1150" y1="76" x2="1150" y2="132" stroke="currentColor"></line>
    <line x1="1150" y1="728" x2="1150" y2="784" stroke="currentColor"></line>
    <line x1="768" y1="430" x2="824" y2="430" stroke="currentColor"></line>
  </g>

  <!-- Traits de construction : diagonale, verticale de composition. -->
  <g class="traits" stroke="currentColor">
    <line x1="48" y1="332" x2="332" y2="48" stroke-dasharray="3 7"></line>
    <line x1="890" y1="48" x2="890" y2="852"></line>
  </g>

  <!-- Croix de repère dispersées, comme sur un calque de chantier. -->
  <g class="marks" stroke="currentColor">
    {
      [
        [400, 220],
        [1080, 170],
        [710, 645],
        [248, 500],
        [1258, 706],
      ].map(([x, y]) => (
        <g>
          <line x1={x - 9} y1={y} x2={x + 9} y2={y} />
          <line x1={x} y1={y - 9} x2={x} y2={y + 9} />
        </g>
      ))
    }
  </g>

  <!-- Ligne de cote, avec ses attaches et son libellé. -->
  <g class="cote">
    <line x1="560" y1="812" x2="880" y2="812" stroke="currentColor"></line>
    <line x1="560" y1="806" x2="560" y2="818" stroke="currentColor"></line>
    <line x1="880" y1="806" x2="880" y2="818" stroke="currentColor"></line>
    <text x="720" y="800">Ø 450 — 20 KG</text>
  </g>
</svg>

<div class="halo"></div>
<div class="grain"></div>

<style>
  /*
   * Hauteur figée en 100svh (« small viewport height ») plutôt que la
   * hauteur implicite de inset:0 : sur mobile, la barre d'adresse qui se
   * rétracte au scroll fait varier la hauteur du viewport en continu, ce qui
   * redimensionnait ces calques fixes en boucle et donnait l'impression que
   * le disque 3D se déformait. 100svh reste stable pendant le scroll (il
   * suppose la barre toujours visible) ; 100vh en repli pour les anciens
   * navigateurs qui ne connaissent pas encore l'unité svh.
   */
  .stage {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100vh;
    height: 100svh;
    z-index: 0;
  }

  .stage canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .blueprint {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100vh;
    height: 100svh;
    z-index: 0;
    pointer-events: none;
    color: var(--text-dim);
  }

  .blueprint line,
  .blueprint rect,
  .blueprint circle {
    vector-effect: non-scaling-stroke;
    stroke-width: 1px;
  }

  .frame {
    opacity: 0.16;
  }

  .corners {
    opacity: 0.28;
  }

  .circles {
    opacity: 0.13;
  }

  .traits {
    opacity: 0.08;
  }

  .marks {
    opacity: 0.2;
  }

  .cote {
    opacity: 0.3;
  }

  .cote text {
    fill: currentColor;
    stroke: none;
    font-family: var(--titre);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-anchor: middle;
    text-transform: uppercase;
  }

  /* Rotation très lente des cercles de construction, comme le disque au repos. */
  .c-slow,
  .c-rev {
    transform-box: fill-box;
    transform-origin: center;
    animation: turn 160s linear infinite;
  }

  .c-rev {
    animation-duration: 120s;
    animation-direction: reverse;
  }

  @keyframes turn {
    to {
      transform: rotate(360deg);
    }
  }

  .halo {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100vh;
    height: 100svh;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(ellipse 80% 60% at 50% 45%, rgba(232, 65, 44, 0.06), transparent 60%);
  }

  /* Tuile 256px affichée à 128px : grain fin, jamais sur le texte. */
  .grain {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100vh;
    height: 100svh;
    z-index: 1;
    pointer-events: none;
    background: url('/grain-tuile-256.png');
    background-size: 128px 128px;
    opacity: 0.05;
  }

  @media (max-width: 720px) {
    /* Sur mobile la feuille se fait discrète : le disque garde la vedette. */
    .traits,
    .cote {
      display: none;
    }

    .circles {
      opacity: 0.09;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .c-slow,
    .c-rev {
      animation: none;
    }
  }
</style>

<script>
  // three.js (~127 Ko gzip) est le plus gros morceau de JS du site : import
  // dynamique + requestIdleCallback pour le sortir du chemin critique de
  // chargement (polices, texte du hero) au lieu de le faire concurrencer
  // ces ressources dès la première seconde. Le disque apparaît quelques
  // dizaines de ms plus tard, imperceptible, pendant que le reste de la
  // page devient utilisable plus vite. Le timeout borne l'attente sur les
  // navigateurs très chargés (le disque reste prioritaire malgré tout).
  const canvas = document.getElementById('gl');
  if (canvas instanceof HTMLCanvasElement) {
    const start = () => {
      import('../scripts/plate').then(({ initPlate }) => initPlate(canvas));
    };
    if ('requestIdleCallback' in window) {
      requestIdleCallback(start, { timeout: 800 });
    } else {
      setTimeout(start, 150);
    }
  }
</script>
