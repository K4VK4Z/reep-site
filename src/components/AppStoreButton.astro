---
/*
 * Bouton App Store — l'application est publiée depuis le 1er septembre 2026.
 *
 * Le lien vient toujours de data/app-store.ts : une autre application s'appelle
 * REEP sur le store, un lien écrit à la main est un risque inutile.
 *
 * `ct` identifie le point d'entrée dans App Store Connect → Analyses → Sources.
 */
import { appStoreUrl } from '../data/app-store';

interface Props {
  /** Jeton de campagne (point d'entrée). Par défaut : le site. */
  ct?: string;
}

const { ct = 'site' } = Astro.props;
---

<a
  class="store"
  href={appStoreUrl(ct)}
  target="_blank"
  rel="noopener"
  aria-label="Télécharger reep sur l'App Store"
>
  <i class="corner tl" aria-hidden="true"></i>
  <i class="corner tr" aria-hidden="true"></i>
  <i class="corner bl" aria-hidden="true"></i>
  <i class="corner br" aria-hidden="true"></i>

  <svg class="apple" viewBox="0 0 384 512" fill="currentColor" aria-hidden="true">
    <path
      d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"
    ></path>
  </svg>

  <span class="st" aria-hidden="true">
    <small>Télécharger sur</small>
    <b>l'App Store</b>
  </span>
</a>

<style>
  .store {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 16px;
    padding: 18px 34px;
    border: 1px solid color-mix(in srgb, var(--text) 25%, transparent);
    border-radius: 16px;
    background: color-mix(in srgb, var(--surface) 60%, transparent);
    color: var(--text);
    text-decoration: none;
    cursor: pointer;
    user-select: none;
    transition:
      border-color 0.4s ease,
      background-color 0.4s ease,
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .store:hover,
  .store:focus-visible {
    border-color: color-mix(in srgb, var(--signal) 70%, transparent);
    background: color-mix(in srgb, var(--surface) 85%, transparent);
    transform: translateY(-2px);
    outline: none;
  }

  .store:active {
    transform: translateY(0);
  }

  .apple {
    width: 30px;
    height: 36px;
    flex: none;
    transition: color 0.4s ease;
  }

  .store:hover .apple,
  .store:focus-visible .apple {
    color: var(--signal);
  }

  .st {
    text-align: left;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 42px;
  }

  .st small {
    display: block;
    font-size: 12px;
    color: var(--text-dim);
    letter-spacing: 0.04em;
  }

  .st b {
    font-family: var(--titre);
    font-weight: 700;
    font-size: 21px;
    letter-spacing: -0.02em;
  }

  /* — Équerres de coin : les repères de cadrage se posent autour du bouton — */

  .corner {
    position: absolute;
    width: 14px;
    height: 14px;
    border: 0 solid var(--signal);
    opacity: 0;
    transition:
      opacity 0.4s ease,
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
  }

  .corner.tl {
    top: -11px;
    left: -11px;
    border-top-width: 1.5px;
    border-left-width: 1.5px;
    transform: translate(8px, 8px);
  }

  .corner.tr {
    top: -11px;
    right: -11px;
    border-top-width: 1.5px;
    border-right-width: 1.5px;
    transform: translate(-8px, 8px);
  }

  .corner.bl {
    bottom: -11px;
    left: -11px;
    border-bottom-width: 1.5px;
    border-left-width: 1.5px;
    transform: translate(8px, -8px);
  }

  .corner.br {
    bottom: -11px;
    right: -11px;
    border-bottom-width: 1.5px;
    border-right-width: 1.5px;
    transform: translate(-8px, -8px);
  }

  .store:hover .corner,
  .store:focus-visible .corner {
    opacity: 1;
    transform: none;
  }

  /* Écrans tactiles : pas de survol, les équerres restent visibles. */
  @media (hover: none) {
    .corner {
      opacity: 1;
      transform: none;
    }
  }
</style>
