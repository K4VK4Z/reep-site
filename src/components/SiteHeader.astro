---
import ReepLogo from './ReepLogo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { ROUTES } from '../data/routes';
---

<header>
  <ReepLogo href={ROUTES.accueil} />
  <div class="header-actions">
    <button class="menu-btn" id="burger" type="button" aria-controls="menu" aria-expanded="false">
      menu<span class="bars" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>
</header>

<ThemeToggle />

<style>
  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 28px 40px;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  @media (max-width: 720px) {
    header {
      padding: 20px 24px;
    }

    .header-actions {
      gap: 20px;
    }
  }
</style>
