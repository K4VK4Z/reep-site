---
// Wordmark officiel « reep. » — texte réel (Space Grotesk 700, bas de
// casse, tracking -0.055em) + carré signal sur la ligne de base, comme
// prescrit par le README du kit logos v2 : « préférer le texte réel [...]
// carré signal 0.13em sur la ligne de base (jamais un « . » texte) ».
// Le carré est un <span> vide en display:inline-block : sans contenu, sa
// baseline est son bord bas, qui s'aligne donc naturellement sur la ligne
// de base du texte — exactement l'effet d'un point final.
interface Props {
  /** Rend le logo comme lien si fourni. */
  href?: string;
  class?: string;
}

const { href, class: className } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag class:list={['logo', className]} {...href ? { href } : {}}>reep<span class="dot" aria-hidden="true"></span></Tag>

<style>
  .logo {
    display: inline-block;
    font-family: var(--titre);
    font-weight: 700;
    font-size: 22px;
    line-height: 1;
    letter-spacing: -0.055em;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
  }

  .logo .dot {
    display: inline-block;
    width: 0.13em;
    height: 0.13em;
    margin-left: 0.05em;
    background: var(--signal);
  }

  @media (max-width: 720px) {
    .logo {
      font-size: 19px;
    }
  }
</style>
