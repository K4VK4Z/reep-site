---
// Logo officiel reep (wordmark + carré, dégradé signal) — repris du SVG de
// l'app (assets/reep-img/reep-logo.svg), recadré sur le tracé pour ne pas
// traîner le canevas 1024×1024 d'origine.
interface Props {
  /** Rend le logo comme lien si fourni. */
  href?: string;
  class?: string;
}

const { href, class: className } = Astro.props;
const Tag = href ? 'a' : 'span';
