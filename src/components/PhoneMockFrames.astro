---
// iPhone 3D (rendu externe) piloté par le scroll : une séquence d'images
// WebP à alpha réelle (pas de fond, juste le téléphone), dessinées sur un
// <canvas> selon la position de scroll — avance vers le bas, recule vers
// le haut. Pas de vidéo : évite tout souci de compatibilité de canal
// alpha entre navigateurs (Safari ne lit pas l'alpha en WebM).
interface Props {
  /** Sous-dossier de public/video/phone-frames/ contenant la séquence. */
  dir: string;
  /** Nombre de frames de la séquence. */
  count: number;
}

const { dir, count } = Astro.props;
---

<div class="mock">
  <canvas
    data-scrub-canvas
    data-frame-base={`/video/phone-frames/${dir}/frame_`}
    data-frame-count={count}
    width="880"
    height="1600"
    aria-hidden="true"
  ></canvas>
</div>

<style>
  .mock {
    flex: none;
    width: min(440px, 42vw);
    aspect-ratio: 880 / 1600;
  }

  .mock canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  @media (max-width: 720px) {
    .mock {
      width: min(320px, 78vw);
    }
  }
</style>
