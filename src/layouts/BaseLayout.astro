---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';

interface Props {
  /** Titre de l'onglet, déjà préfixé « reep — » par le layout. */
  title: string;
  description?: string;
  /** Classe posée sur <body> (ex. « legal » pour les pages de contenu). */
  bodyClass?: string;
}

const {
  title,
  description = "reep — le carnet d'entraînement qui retient tout. Disponible sur l'App Store.",
  bodyClass,
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#141312" id="meta-theme-color" />
    <!--
      Anti-flash : pose le thème clair avant le premier paint si c'est la
      préférence enregistrée (le thème sombre est déjà celui de :root, donc
      rien à faire dans ce cas). Doit rester un script inline, non un module,
      pour s'exécuter avant que le CSS ne soit appliqué.
    -->
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem('reep-theme') === 'light') {
            document.documentElement.dataset.theme = 'light';
          }
        } catch (e) {}
      })();
    </script>
    <title>reep — {title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Space+Grotesk:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <Analytics />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
