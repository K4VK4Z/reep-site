---
import '../styles/home.css';

import BaseLayout from '../layouts/BaseLayout.astro';
import Backdrop from '../components/Backdrop.astro';
import SiteHeader from '../components/SiteHeader.astro';
import FullscreenMenu from '../components/FullscreenMenu.astro';
import FeatureSection from '../components/FeatureSection.astro';
import MoreFeatures from '../components/MoreFeatures.astro';
import AppStoreButton from '../components/AppStoreButton.astro';
import AndroidWaitlist from '../components/AndroidWaitlist.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Wordmark from '../components/Wordmark.astro';
import { FEATURES } from '../data/features';
import { ROUTES } from '../data/routes';
import { APP_ID, appStoreUrl } from '../data/app-store';

const donneesStructurees = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'reep',
  applicationCategory: 'HealthApplication',
  operatingSystem: 'iOS',
  url: 'https://reepapp.fr',
  sameAs: [appStoreUrl()],
  description:
    "Suivi de séance de musculation avec la salle dedans : qui s'entraîne maintenant, le classement du mois, les records des amis en direct.",
  inLanguage: 'fr-FR',
  author: { '@type': 'Person', name: 'Edmond Lomy' },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  identifier: APP_ID,
};
---

<BaseLayout title="app de musculation" ogTitle="reep — ta salle va changer.">
  {/*
    Données structurées : dit à Google que reep est une application iOS et
    quel lien App Store lui appartient. Une autre application s'appelle REEP
    sur le store — sans ça, rien ne distingue les deux dans les résultats.
  */}
  <script type="application/ld+json" is:inline set:html={JSON.stringify(donneesStructurees)} />

  <Backdrop />
  <SiteHeader />
  <FullscreenMenu />

  <main>
    <section class="hero load">
      <div class="inner">
        <p class="eyebrow">app de musculation</p>
        <h1>Ta salle va<br />changer<span class="s">.</span></h1>
        <p class="sub">
          Un programme qui s'adapte à toi, des stats qui prouvent que tu avances, une salle
          qui vit autour de toi. reep transforme chaque séance en progrès mesurable. Fais défiler.
        </p>
      </div>
      <div class="scrollhint"><span>scroll</span><span class="line"></span></div>
    </section>

    {FEATURES.map((feature, i) => <FeatureSection feature={feature} alt={i % 2 === 1} />)}

    <MoreFeatures />

    <section class="final">
      <div class="inner reveal">
        <Wordmark />
        <p>
          Ton suivi de séance, avec ta salle dedans.<br />
          Maintenant entre tes mains.
        </p>
        <AppStoreButton />
        <AndroidWaitlist />
      </div>
    </section>

    <section class="contact">
      <div class="inner reveal">
        <p class="contact-title">Une question<span class="s">.</span></p>
        <a class="contact-mail" href="mailto:edostudio@proton.me">edostudio@proton.me</a>
      </div>
    </section>
  </main>

  <SiteFooter
    links={[
      { href: ROUTES.support, label: 'aide' },
      { href: ROUTES.mentionsLegales, label: 'mentions légales' },
      { href: ROUTES.confidentialite, label: 'confidentialité' },
      { href: ROUTES.cgu, label: "conditions d'utilisation" },
    ]}
  />
</BaseLayout>

<script>
  import { initReveals } from '../scripts/reveal';
  import { initFrameScrub } from '../scripts/frame-scrub';

  initReveals();
  initFrameScrub();
</script>
